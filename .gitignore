# ===== 비밀값 =====
# .env 에는 API 키 같은 비밀값이 들어가므로 절대 깃에 올리지 않는다.
.env
.env.*
!.env.example

# ===== 데이터 =====
# 원본/가공 데이터는 용량이 크고 재현 가능하므로 깃에 올리지 않는다.
# (단, .gitkeep 은 빈 폴더 구조를 유지하기 위해 예외로 둔다)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# ===== 산출물 그림 =====
# 그림(.png)은 보고서의 일부이므로 깃에 포함한다.
# (포트폴리오로 공유할 때 GitHub 에서 바로 보이도록)
# 그 외 임시 파일만 제외한다.
reports/figures/*
!reports/figures/.gitkeep
!reports/figures/*.png

# ===== 파이썬 =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.Python

# ===== 주피터 노트북 =====
.ipynb_checkpoints/

# ===== 에디터 / OS =====
.vscode/
.idea/
.DS_Store
