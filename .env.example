# ============================================================
# .env 예시 파일 (이 파일은 깃에 올라가도 안전한 "빈 껍데기"다)
# 사용법: 이 파일을 복사해서 .env 로 이름을 바꾸고, 실제 값을 채운다.
#   cp .env.example .env
# 실제 .env 는 .gitignore 에 등록되어 있어 깃에 올라가지 않는다.
# ============================================================

# ----- 데이터 경로 설정 -----
# 원본 CSV 가 놓일 폴더 (Kaggle 에서 받은 transaction_dataset.csv 를 여기에 둔다)
RAW_DATA_DIRECTORY=data/raw
# 전처리(가공)가 끝난 데이터가 저장될 폴더
PROCESSED_DATA_DIRECTORY=data/processed
# 표/그림 같은 분석 산출물이 저장될 폴더
REPORTS_DIRECTORY=reports
# 분석 대상 원본 파일 이름
RAW_DATASET_FILENAME=transaction_dataset.csv

# ----- 실험 재현성 설정 -----
# 난수 시드: 같은 값을 쓰면 매번 같은 결과가 나온다 (교차검증 분할 등에 사용)
RANDOM_SEED=42
# 교차검증 fold 개수 (과제 요구사항: 층화 5-fold)
CROSS_VALIDATION_FOLDS=5

# ----- 외부 API 키 (아직 사용하지 않음. 나중에 온체인 API 를 붙일 때를 대비) -----
# 값이 비어 있어도 현재 파이프라인은 정상 동작한다.
ETHERSCAN_API_KEY=
COVALENT_API_KEY=
